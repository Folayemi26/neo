# Neo Backend Environment Variables
# Copy this file to .env and fill in your actual API keys

# Google Maps API Key (for routes and location services)
GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Gemini API Key (for AI text/audio processing)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: You can also use GOOGLE_API_KEY instead of separate keys
# GOOGLE_API_KEY=your_google_api_key_here
# Optional: pin a specific Gemini model. When unset, the server walks a
# ladder (gemini-flash-latest, then gemini-3.8-flash, then gemini-3.5-flash)
# and uses the first one the key can actually call.
#
# Pin this for a live demo. The floating alias is occasionally rate-limited
# with a 503, and walking past two such failures adds ~3s to the first
# request. Pinning a model that is known to answer keeps it near 2.4s.
# GEMINI_MODEL=gemini-3.5-flash

# Optional: how long to wait for Gemini before falling back to keyword
# triage, in milliseconds. Defaults to 12000.
# GEMINI_TIMEOUT_MS=12000

# --- ElevenLabs (spoken emergency alerts for responders) ---
# Without this the responder UI still shows every emergency detail and can
# still accept; only the audio button reports that voice is unconfigured.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional. Voice ids are account-specific; the default is an ElevenLabs
# stock voice. Pick one from your account's voice library.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional. Multilingual by default so a non-English alert can be spoken
# with the same configuration.
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional. Milliseconds to wait before giving up on synthesis.
# ELEVENLABS_TIMEOUT_MS=15000

# Optional. Overrides the ElevenLabs endpoint. Only needed to route through
# a proxy, or to point the voice path at a stub while testing.
# ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1/text-to-speech
